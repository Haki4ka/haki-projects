{
  "manifest_version": 3,
  "name": "Haki OLED",
  "short_name": "Haki OLED",
  "version": "1.1.1",
  "description": "Deep OLED-black browser theme, tuned for Brave.",
  "theme": {
    "images": {
      "theme_frame": "images/frame.png",
      "theme_toolbar": "images/toolbar.png",
      "theme_tab_background": "images/tab_background.png",
      "theme_ntp_background": "images/ntp_background.png"
    },
    "colors": {
      "frame": [0, 0, 0],
      "frame_inactive": [0, 0, 0],
      "frame_incognito": [0, 0, 0],
      "frame_incognito_inactive": [0, 0, 0],
      "toolbar": [0, 0, 0],
      "tab_text": [232, 232, 232],
      "tab_background_text": [150, 150, 150],
      "tab_background_text_inactive": [120, 120, 120],
      "background_tab": [0, 0, 0],
      "background_tab_inactive": [0, 0, 0],
      "toolbar_text": [200, 200, 200],
      "bookmark_text": [200, 200, 200],
      "omnibox_background": [10, 10, 10],
      "omnibox_text": [232, 232, 232],
      "ntp_background": [0, 0, 0],
      "ntp_header": [0, 0, 0],
      "ntp_text": [200, 200, 200],
      "ntp_link": [78, 156, 142],
      "button_background": [0, 0, 0]
    },
    "tints": {
      "frame_inactive": [-1, -1, 0],
      "frame_incognito_inactive": [-1, -1, 0]
    },
    "properties": {
      "ntp_background_alignment": "center",
      "ntp_background_repeat": "no-repeat",
      "ntp_logo_alternate": 1
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
